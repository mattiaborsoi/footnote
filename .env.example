# Copy to .env (chmod 600) and fill in. .env is never committed.

# Any OpenAI-compatible chat endpoint. Locally a proxy on the host machine; in production LiteLLM.
LLM_BASE_URL=http://host.docker.internal:4100/v1
LLM_API_KEY=not-needed-locally
LLM_MODEL_INTERPRET=haiku
LLM_MODEL_CURATE=opus

# Postgres password for the db container (the app receives DATABASE_URL from compose.yml)
POSTGRES_PASSWORD=change-me

# Public URL of this instance
APP_URL=http://localhost:3002

# Scout layer: a SearXNG instance for web search (locally one on the host), and a token for the admin trigger
SEARXNG_URL=http://host.docker.internal:8888
ADMIN_TOKEN=change-me

# Background scheduler (places cache, presets, scouting every six hours); set to off for one-off containers
SCHEDULER=on

# Hostnames the dev server may be opened from (development only)
DEV_ORIGINS=

# Sign-in: a long random string folded into every stored code, link and session hash
AUTH_SECRET=change-me-to-32-random-characters
# Mail: compose.yml points SMTP_HOST at Mailpit locally; production uses the transactional provider's SMTP
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Footnote <no-reply@localhost>
# Where feedback notifications go (leave empty to skip)
FEEDBACK_TO=
# More throwaway email domains, comma-separated (a built-in list exists)
THROWAWAY_DOMAINS=

# Trial and passes: free walks, then "up to N walks" per pass, and the labels shown (Stripe holds the real prices)
TRIAL_WALKS=1
PLAN_WEEK_WALKS=8
PLAN_MONTH_WALKS=25
PLAN_WEEK_PRICE=£4.99
PLAN_MONTH_PRICE=£7.99
# Stripe (test keys locally): secret key, the webhook signing secret, and the two price ids
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WEEK=
STRIPE_PRICE_MONTH=
