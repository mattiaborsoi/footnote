# Production .env for /opt/footnote (chmod 600). Secrets only live here.

# The site, and the image CI pushes on every merge to main (ghcr.io/<github owner>/footnote:main)
SITE_HOST=walks.example.com
APP_URL=https://walks.example.com
APP_IMAGE=ghcr.io/OWNER/footnote:main

# Model access: the app's own LiteLLM key (budget-capped, generated once by the bootstrap) and the model names in litellm.yaml
LLM_API_KEY=sk-...
LLM_MODEL_INTERPRET=haiku
LLM_MODEL_CURATE=opus
# LiteLLM itself: the provider key and its own secrets (random, 32+ characters each)
ANTHROPIC_API_KEY=
LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=change-me

# Databases
POSTGRES_PASSWORD=change-me

# Scout layer
SEARXNG_SECRET=change-me
ADMIN_TOKEN=change-me
SCHEDULER=on

# Sign-in and mail (the transactional provider's SMTP)
AUTH_SECRET=change-me
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Footnote <no-reply@example.com>
FEEDBACK_TO=
THROWAWAY_DOMAINS=

# Trial, passes and Stripe (live keys here, test keys on the test environment)
TRIAL_WALKS=1
PLAN_WEEK_WALKS=8
PLAN_MONTH_WALKS=25
PLAN_WEEK_PRICE=£4.99
PLAN_MONTH_PRICE=£7.99
WALK_COST_LABEL=about 40p
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WEEK=
STRIPE_PRICE_MONTH=

# Model prices, for the dashboard's cost figures when the mirror is pulled
LLM_PRICE_IN_PER_M=5
LLM_PRICE_OUT_PER_M=25
LLM_PRICE_CURRENCY=$
